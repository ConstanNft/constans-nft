# ─────────────────────────────────────────────────────────────
#  CONSTANTS NFT — DEPLOYMENT ENV
# ─────────────────────────────────────────────────────────────

# 1. Wallet that will deploy + own the contract.
#    This wallet pays gas. Keep its key secret. Use a fresh
#    deployer wallet, NOT your main vault.
DEPLOYER_PRIVATE_KEY=0xYOUR_DEPLOYER_PRIVATE_KEY_HEX

# 2. Wallet that receives royalties on resales (can be same as deployer).
ROYALTY_RECEIVER=0xYOUR_ROYALTY_WALLET

# 3. Royalty in basis points. 500 = 5%.
ROYALTY_BPS=500

# 4. Mint price in ether (0.001 ETH = ~$3).
MINT_PRICE_ETH=0.001

# 5. RPC endpoints. Free public endpoints work; Alchemy/Infura
#    are more reliable for high traffic.
MAINNET_RPC_URL=https://eth.llamarpc.com
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# 6. Etherscan API key (free at etherscan.io/apis) — works for both
#    Ethereum mainnet AND Sepolia. Set this if deploying to mainnet.
ETHERSCAN_API_KEY=

# 6b. Basescan API key for Base verification (only if using Base).
BASESCAN_API_KEY=

# 7. Pinata JWT for IPFS uploads (free at pinata.cloud, 1GB free tier).
PINATA_JWT=

# 8. After image upload step, paste the resulting CID here.
#    Example: bafybeihxxxxxxxxxxxxxxxxxxxxxxx
IMAGES_CID=

# 9. After metadata upload, paste the resulting CID here.
#    Used as baseURI of the contract: ipfs://<METADATA_CID>/
METADATA_CID=

# 10. Address of deployed contract (filled automatically after deploy).
CONTRACT_ADDRESS=
